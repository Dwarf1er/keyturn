<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Published as a trimmed, self-contained single file (scripts/publish.sh): NativeAOT cannot embed Skia/HarfBuzz. -->
    <PublishTrimmed>true</PublishTrimmed>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows: the exe icon (Explorer, Start Menu shortcut, taskbar). Ignored when targeting other OSes. -->
    <ApplicationIcon>..\..\assets\keyturn.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <!-- The runtime won't start on Linux without libicu unless globalization is invariant; Windows/macOS keep localized formats. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <!-- Patched backport (CVE-2026-39959); Avalonia 11.3.12 still pulls 0.21.2 transitively. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The window icon, shared with the repo's icon set so there is only one copy. -->
    <AvaloniaResource Include="..\..\assets\icons\keyturn-256.png" Link="Assets\keyturn.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keyturn.Core\Keyturn.Core.csproj" />
  </ItemGroup>
</Project>
