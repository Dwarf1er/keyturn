<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback for machines without a NativeAOT toolchain: a self-contained, trimmed single file that only needs the
     .NET SDK to build. Larger and slower to start than the AOT build, and otherwise identical.
     Use: dotnet publish src/Keyturn.Cli -r <rid> -p:PublishProfile=jit -o <dir> -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishAot>false</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
