<?xml version="1.0" encoding="utf-8"?>
<!-- The CLI is on other tools' hot path: NativeAOT gives a ~3 MB single file that starts in milliseconds.
     Needs a native toolchain (clang + zlib on Linux, Visual Studio C++ tools on Windows, Xcode on macOS).
     Use: dotnet publish src/Keyturn.Cli -r <rid> -p:PublishProfile=release -o <dir> -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishAot>true</PublishAot>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
