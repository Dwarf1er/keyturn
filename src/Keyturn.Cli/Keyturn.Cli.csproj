<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Keyturn.Core\Keyturn.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>keyturn</AssemblyName>
    <RootNamespace>Keyturn.Cli</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <ApplicationIcon>..\..\assets\keyturn.ico</ApplicationIcon>
    <!-- No ICU dependency (servers, containers) and locale-independent output for scripts. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Keyturn.Tests" />
  </ItemGroup>

</Project>
